{
  "productName": "Smart Pangya Calculator",
  "version": "3.0.2",
  "identifier": "com.onezim.smart-pangya-calculator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "url": "index.html",
        "label": "main",
        "title": "Smart Pangya Calculator",
        "width": 950,
        "height": 850,
        "visible": false,
        "decorations": false,
        "transparent": false
      },
      {
        "label": "settings_screen",
        "title": "Settings",
        "url": "screens/settings/settings_screen.html",
        "width": 800,
        "height": 620,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      },
      {
        "label": "overlays_screen",
        "title": "Overlays",
        "url": "screens/overlays/overlays_screen.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      },
      {
        "label": "editor_screen",
        "title": "Course Editor",
        "url": "screens/editor/editor_screen.html",
        "width": 600,
        "height": 500,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      },
      {
        "label": "ruler_overlay",
        "title": "Overlay Règle",
        "url": "overlays/ruler_overlay/ruler_overlay.html",
        "width": 1920,
        "height": 150,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "input_overlay",
        "title": "Overlay Saisie",
        "url": "overlays/calc_overlay/calc_overlay.html",
        "width": 350,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "minWidth": 350,
        "minHeight": 420,
        "shadow": false
      },
      {
        "label": "spin_overlay",
        "title": "Spin Overlay",
        "url": "overlays/spin_overlay/spin_overlay.html",
        "width": 200,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "infos_shot",
        "title": "Infos Tir",
        "url": "overlays/infos_shot/infos_shot.html",
        "width": 500,
        "height": 150,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["data/*", "lang/*"]
  },
  "plugins": {
    "dialog": null
  }
}
